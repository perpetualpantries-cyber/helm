{
  "functions": {
    "api/claude.js": { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/cron/auto-execute", "schedule": "0 21 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
